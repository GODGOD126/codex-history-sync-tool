{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex History Sync",
  "version": "0.1.0",
  "identifier": "com.codex.historysync",
  "build": {
    "beforeDevCommand": "npm --prefix ../modern-ui run start:tauri",
    "devUrl": "http://127.0.0.1:4758",
    "frontendDist": "../../modern-ui/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex History Sync",
        "width": 1200,
        "height": 760,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
